import kotlin.Long;

CREATE TABLE TagBlocks (
  tag TEXT PRIMARY KEY NOT NULL,
  expiration_millis INTEGER AS Long
);

selectAll:
SELECT tag, expiration_millis FROM TagBlocks ORDER BY tag;

selectActiveTags:
SELECT tag
FROM TagBlocks
WHERE expiration_millis IS NULL
  OR expiration_millis > CAST(unixepoch('subsec') * 1000 AS INTEGER);

upsert:
INSERT INTO TagBlocks(tag, expiration_millis)
VALUES (?, ?)
ON CONFLICT(tag) DO UPDATE SET
  expiration_millis = excluded.expiration_millis;

insert:
INSERT INTO TagBlocks(tag, expiration_millis)
VALUES (?, ?);

deleteByTag:
DELETE FROM TagBlocks WHERE tag = ?;

deleteExpired:
DELETE FROM TagBlocks
WHERE expiration_millis IS NOT NULL
  AND expiration_millis <= CAST(unixepoch('subsec') * 1000 AS INTEGER);

deleteAll:
DELETE FROM TagBlocks;
